{
  "manifest_version": 3,
  "name": "FocusBlock",
  "version": "1.0.0",
  "description": "Block distracting websites during Focus and Lockdown sessions.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/focusblock-16.png",
    "48": "icons/focusblock-48.png",
    "128": "icons/focusblock-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.fb.com/*",
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.tiktok.com/*",
    "*://*.reddit.com/*",
    "*://*.linkedin.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "FocusBlock",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/focusblock-16.png",
      "32": "icons/focusblock-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "blocked/blocked.css",
        "blocked/blocked.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
